{
    "crystalmaiden_cm_spawn_03": "氷の乙女よ!",
    "crystalmaiden_cm_spawn_04": "アイスはナイスね!",
    "crystalmaiden_cm_spawn_06": "Icewrackの惨劇を見よ!",
    "crystalmaiden_cm_spawn_05": "凍えて待ってて!",
    "crystalmaiden_cm_spawn_07": "始まるわよ!",
    "crystalmaiden_cm_spawn_08": "戦いの始まり!",
    "crystalmaiden_cm_firstblood_01": "ファーストブラッドよ、もうアイシングは済んだわ!",
    "crystalmaiden_cm_move_03": "動くわ!",
    "crystalmaiden_cm_move_04": "前進!",
    "crystalmaiden_cm_move_05": "分かったわ!",
    "crystalmaiden_cm_move_06": "そう思ってたよ!",
    "crystalmaiden_cm_move_07": "レッツゴー!",
    "crystalmaiden_cm_move_08": "そこね!",
    "crystalmaiden_cm_move_09": "はーい!",
    "crystalmaiden_cm_move_10": "速く!",
    "crystalmaiden_cm_move_12": "向かっているよ!",
    "crystalmaiden_cm_move_13": "突撃!",
    "crystalmaiden_cm_move_14": "間違ってないと思うわ。",
    "crystalmaiden_cm_move_15": "もちろん!",
    "crystalmaiden_cm_acknow_01": "えっ",
    "crystalmaiden_cm_acknow_02": "うーん。",
    "crystalmaiden_cm_acknow_04": "なるほど。",
    "crystalmaiden_cm_attack_01": "攻撃!",
    "crystalmaiden_cm_attack_03": "この氷は噛むよ!",
    "crystalmaiden_cm_attack_04": "氷を見せてあげる!",
    "crystalmaiden_cm_attack_06": "氷狼は噛むよ!",
    "crystalmaiden_cm_attack_07": "氷の牙!",
    "crystalmaiden_cm_attack_05": "死んで!",
    "crystalmaiden_cm_attack_08": "下がれ!",
    "crystalmaiden_cm_attack_09": "速く凍らせてあげるね!",
    "crystalmaiden_cm_cast_01": "吹き出てきたね!",
    "crystalmaiden_cm_cast_03": "準備オッケー!",
    "crystalmaiden_cm_cast_04": "これはチャンス。",
    "crystalmaiden_cm_cast_05": "まさかとは思ったけど…",
    "crystalmaiden_cm_levelup_01": "体温が下がってきたよ。",
    "crystalmaiden_cm_levelup_02": "十分冷たいみたい!",
    "crystalmaiden_cm_levelup_04": "鳥肌が立ってきたよ!",
    "crystalmaiden_cm_levelup_05": "えへへへ!",
    "crystalmaiden_cm_levelup_06": "えへへへへ!",
    "crystalmaiden_cm_kill_01": "氷の中に埋もれてね…",
    "crystalmaiden_cm_kill_03": "燃えるのとは違うでしょ?",
    "crystalmaiden_cm_kill_04": "あなたも冷凍廃棄物行きね!",
    "crystalmaiden_cm_kill_05": "君の動き、Blueheart Glacierのみたいだったよ!",
    "crystalmaiden_cm_kill_06": "頭冷やしてね!",
    "crystalmaiden_cm_kill_08": "アイスはいつでもナイスとは限らないよ。",
    "crystalmaiden_cm_kill_09": "素敵な雪の彫刻になれるよ。",
    "crystalmaiden_cm_kill_10": "息してるのが見えなくなっちゃった。",
    "crystalmaiden_cm_kill_12": "次は暖かい服装できてね。",
    "crystalmaiden_cm_kill_13": "君は死んじゃってそれは冷酷な事実なんだよ。",
    "crystalmaiden_cm_kill_15": "冷たい手を握って。",
    "crystalmaiden_cm_kill_16": "あははははは!",
    "crystalmaiden_cm_kill_17": "あはははは!",
    "crystalmaiden_cm_kill_19": "ははははは!",
    "crystalmaiden_cm_kill_20": "うふふふふふふふ。",
    "crystalmaiden_cm_rival_01": "氷は炎に勝るのよ。",
    "crystalmaiden_cm_rival_03": "今回Linaは氷で終わるのね。",
    "crystalmaiden_cm_rival_04": "老いぼれめ。",
    "crystalmaiden_cm_rival_07": "雪は降らせられないの?",
    "crystalmaiden_cm_rival_08": "嵐で私の結晶をめちゃくちゃにしてくれたわね。",
    "crystalmaiden_cm_rival_10": "そして、嵐は静まり返った。",
    "crystalmaiden_cm_rival_11": "これはテストよ、Tinker、そしてあなたは赤点だったの。",
    "crystalmaiden_cm_rival_13": "次は体温を測ってからにして。",
    "crystalmaiden_cm_rival_14": "もう私の雪を踏み潰させない。",
    "crystalmaiden_cm_rival_15": "ねえ、女王様、もっと氷で冷やしたら。",
    "crystalmaiden_cm_rival_17": "片方は好きだったんだけどね。",
    "crystalmaiden_cm_rival_18": "古くて、寒くて、壊れてる。",
    "crystalmaiden_cm_rival_19": "雪合戦をしたのが恋しいよ。",
    "crystalmaiden_cm_ally_01": "お姉ちゃん、ついてこられるかな!",
    "crystalmaiden_cm_spawn_01": "Crystal Maidenよ!",
    "crystalmaiden_cm_spawn_02": "Crystal Maidenを呼んだのは誰かしら?",
    "crystalmaiden_cm_battlebegins_01": "誰かが固まるまでゲームはずっと楽しいわね。",
    "crystalmaiden_cm_move_01": "戦いへ!",
    "crystalmaiden_cm_move_02": "急げ!",
    "crystalmaiden_cm_move_11": "Icewrackの狼のように急げ...",
    "crystalmaiden_cm_acknow_03": "それで。",
    "crystalmaiden_cm_attack_02": "氷を喰らえ!",
    "crystalmaiden_cm_cast_02": "ずっと待ってたの…",
    "crystalmaiden_cm_levelup_03": "冷たいのは私だけ?",
    "crystalmaiden_cm_levelup_07": "ブルブル、いい感じね。",
    "crystalmaiden_cm_kill_02": "フロストファイアを喰らえ!",
    "crystalmaiden_cm_kill_07": "ちょっとした氷鬼ごっこが命取りになるって知らなかったのね。",
    "crystalmaiden_cm_kill_11": "あなたの運命はいつまでもクリスタルのように澄んでいた。",
    "crystalmaiden_cm_kill_14": "血が凍ったね。",
    "crystalmaiden_cm_kill_18": "むふむはははは!",
    "crystalmaiden_cm_rival_02": "もういいのよ、Lina、あなたは私を溶かそうとした。",
    "crystalmaiden_cm_rival_06": "ごめんなさい、Lich、あなたは間違ったことをしている。",
    "crystalmaiden_cm_rival_09": "威勢は良すぎ、雪少なすぎ。",
    "crystalmaiden_cm_rival_12": "Tinker、あなたの数式はちっとも冷たくないわ。",
    "crystalmaiden_cm_rival_16": "痛みの女王?",
    "crystalmaiden_cm_rival_21": "雪合戦をしたのが恋しいよ、Ymir。",
